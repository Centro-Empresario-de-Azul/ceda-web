{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ceda-web",
  "compatibility_date": "2026-07-02",
  "observability": {
    "enabled": true,
  },
  // Cloudflare Workers Builds runs the deploy command only. Without this hook there is
  // no dist/ to upload, and `wrangler deploy` fails on a missing assets directory.
  "build": {
    "command": "npm run build",
  },

  // Custom domain, ready to enable once ceda.org.ar is delegated to Cloudflare — `wrangler
  // deploy` creates the domain via the API, so it fails on a zone it can't find yet. Only
  // www is listed; the apex redirects to www via a Cloudflare Redirect Rule ahead of Workers.
  // "routes": [
  //   { "pattern": "www.ceda.org.ar", "custom_domain": true }
  // ],

  "assets": {
    "directory": "./dist",
    // Without this, unknown paths return an empty body instead of dist/404.html.
    "not_found_handling": "404-page",
  },
}
