# Pin this project to the public registry. Without it, a contributor whose global
# ~/.npmrc points at a private registry regenerates a lockfile that CI cannot install.
registry=https://registry.npmjs.org/

# Astro 7 needs Node >=22.12.0. Without this the version mismatch surfaces as an opaque
# Vite error at build time instead of a clear message at install time.
engine-strict=true
