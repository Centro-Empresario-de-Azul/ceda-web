---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { site } from '../site';
import type { Issue } from '../data/magazine';

interface Props {
  issue: Issue;
  /** Resolved by the caller — only the page knows the cover glob. */
  cover: ImageMetadata;
}
const { issue, cover } = Astro.props;
---

<li>
  <a href={`/revista/${issue.number}`} class="group block">
    <Image
      src={cover}
      alt={`Tapa de Imagen ${site.acronym} número ${issue.number}, ${issue.date}`}
      widths={[240, 420]}
      sizes="(max-width: 640px) 45vw, 22vw"
      loading="lazy"
      class="w-full rounded-xl border border-sky-2 transition-shadow group-hover:shadow-[0_14px_36px_-20px_rgba(28,58,112,0.5)]"
    />
    <p class="mt-3 font-semibold text-navy">Número {issue.number}</p>
    <p class="text-sm text-muted">
      <time datetime={issue.iso}>{issue.date}</time>
    </p>
  </a>
  <a
    href={issue.pdf}
    download={`Imagen ${site.acronym} ${issue.number} (web).pdf`}
    class="link-underline mt-1 inline-flex items-center gap-1 text-xs font-semibold text-muted"
    aria-label={`Descargar Imagen ${site.acronym} número ${issue.number} en PDF`}
  >
    <Icon name="lucide:download" class="size-3.5" aria-hidden="true" />
    Descargar PDF
  </a>
</li>
