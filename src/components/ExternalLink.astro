---
// Every link that leaves the site, in one place. `rel="noopener noreferrer"` alongside
// target="_blank" is a security requirement, not a style choice — centralising it means it
// cannot be forgotten on the next link someone adds. `rest` is spread first so a caller
// cannot override href/target/rel out of it.
interface Props {
  href: string;
  class?: string;
  [key: string]: unknown;
}
const { href, class: className, ...rest } = Astro.props;
---

<a {...rest} href={href} target="_blank" rel="noopener noreferrer" class={className}>
  <slot />
</a>
