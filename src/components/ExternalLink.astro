---
// Every external link, in one place, so `rel="noopener noreferrer"` can't be forgotten.
// `rest` is spread first so a caller can't override href/target/rel out of it.
interface Props {
  href: string;
  class?: string;
  [key: string]: unknown;
}
const { href, class: className, ...rest } = Astro.props;
---

<a {...rest} href={href} target="_blank" rel="noopener noreferrer" class={className}>
  <slot />
</a>
