---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import SlashBand from '../components/SlashBand.astro';
import MarkerCircle from '../components/MarkerCircle.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ExternalLink from '../components/ExternalLink.astro';
import IssueCard from '../components/IssueCard.astro';
import { site, affiliationsProse, whatsappJoinUrl } from '../site';
import { upcoming } from '../data/events';
import { benefits, benefitTags, membership, historyMilestones } from '../data/institutional';
import { advocacy } from '../data/advocacy';
import { issues, latest } from '../data/magazine';
import { coverFor } from '../lib/magazine-covers';
import { posterFor } from '../lib/event-posters';
import { yearsSince } from '../lib/stats';

const years = yearsSince(site.foundedISO, new Date());
const latestCover = coverFor(latest.cover);
const recentIssues = issues.slice(0, 6);
const recentAdvocacy = advocacy.slice(0, 4);
const benefitPreview = benefits.slice(0, 6);

const monthYear = new Intl.DateTimeFormat('es-AR', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const dayMonthYear = new Intl.DateTimeFormat('es-AR', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});

// What CEDA does, each pillar ending in something dated and real rather than a slogan.
const latestAdvocacy = advocacy[0];
const pillars = [
  {
    verb: 'Representa',
    body: 'Lleva la voz de las empresas de Azul ante el municipio, el Concejo Deliberante y las entidades provinciales y nacionales.',
    live: latestAdvocacy.title,
    liveMeta: monthYear.format(new Date(latestAdvocacy.date)),
    href: '/nosotros#gestiones',
    cta: 'Ver gestiones',
  },
  upcoming
    ? {
        verb: 'Conecta',
        body: 'Charlas, jornadas y encuentros para que las empresas de la ciudad se conozcan y hagan negocios.',
        live: upcoming.title,
        liveMeta: `${upcoming.dateLabel}, ${upcoming.timeLabel} h`,
        href: '/programas',
        cta: 'Ver la actividad',
      }
    : {
        verb: 'Conecta',
        body: 'Encuentros, rondas de negocios y la guía de comercios, oficios y servicios de Azul que arma la Subcomisión de Jóvenes.',
        live: 'Guía de Azul',
        liveMeta: 'Registrá tu negocio, es gratis',
        href: '/programas',
        cta: 'Conocé los programas',
      },
  {
    verb: 'Informa',
    body: `Imagen ${site.acronym}, nuestra revista digital: actualidad del comercio y la industria de Azul.`,
    live: `N.º ${latest.number} · ${latest.headline}`,
    liveMeta: latest.date,
    href: `/revista/${latest.number}`,
    cta: 'Leer online',
  },
];

const shadow = 'shadow-[0_24px_50px_-24px_rgba(13,27,54,0.55)]';
---

<Base
  title={`${site.acronym} — ${site.name}`}
  description={`${site.description} Desde ${site.founded}.`}
>
  {/* Hero: type-led, on light ground. CEDA's own printed material is the imagery. */}
  <section class="relative overflow-hidden bg-sky">
    <div
      class="mx-auto grid max-w-6xl items-center gap-14 px-5 pt-16 pb-24 md:pt-20 md:pb-28 lg:grid-cols-[1.25fr_1fr] lg:gap-10"
    >
      <div>
        <p class="eyebrow text-orange-deep">
          Cámara empresarial · {site.city} · desde {site.founded}
        </p>
        <h1 class="display-tight mt-6 text-display text-navy">
          Juntos es <MarkerCircle>mejor</MarkerCircle>
        </h1>
        <p class="mt-8 max-w-xl text-xl leading-relaxed text-muted md:text-2xl">
          El comercio, la industria y los servicios de {site.city}, organizados desde {
            site.founded
          }:{' '}
          <strong class="font-semibold text-ink">{years} años gestionando</strong> ante el municipio y
          <strong class="font-semibold text-ink">{latest.number} ediciones</strong> de nuestra revista.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href="/beneficios#asociate" class="btn-primary">Asociate</a>
          <ExternalLink href={site.whatsappUrl} class="btn-outline inline-flex items-center gap-2">
            <Icon name="simple-icons:whatsapp" class="size-4" aria-hidden="true" />
            Escribinos
          </ExternalLink>
        </div>
      </div>

      <div class="relative mx-auto flex w-full max-w-md items-end justify-center gap-5 sm:gap-6">
        {
          upcoming && (
            <a href="/programas" class="w-1/2 -rotate-2 transition-transform hover:rotate-0">
              <Image
                src={posterFor(upcoming.poster, upcoming.title)}
                alt={`Afiche de ${upcoming.title}`}
                widths={[240, 420]}
                sizes="(max-width: 1024px) 45vw, 20vw"
                loading="eager"
                class:list={['w-full rounded-xl', shadow]}
              />
              <span class="mt-3 block text-sm font-semibold text-navy">
                Próxima actividad · {upcoming.dateLabel}
              </span>
            </a>
          )
        }
        <a
          href={`/revista/${latest.number}`}
          class:list={[
            'rotate-2 transition-transform hover:rotate-0',
            upcoming ? 'w-1/2' : 'w-3/4',
          ]}
        >
          <Image
            src={latestCover}
            alt={`Tapa de Imagen ${site.acronym} número ${latest.number}, ${latest.date}`}
            widths={[320, 560]}
            sizes="(max-width: 1024px) 60vw, 28vw"
            loading="eager"
            fetchpriority="high"
            class:list={['w-full rounded-xl', shadow]}
          />
          <span class="mt-3 block text-sm font-semibold text-navy">
            Revista N.º {latest.number} · {latest.date}
          </span>
        </a>
      </div>
    </div>
    <SlashBand height="h-3" class="absolute bottom-0 left-0" />
  </section>

  <section class="mx-auto max-w-6xl px-5 py-20 md:py-28" aria-labelledby="que-hacemos">
    <h2 id="que-hacemos" class="eyebrow text-orange-deep">Qué hace el {site.acronym}</h2>
    <div class="mt-10 grid gap-12 md:grid-cols-3 md:gap-10">
      {
        pillars.map((p) => (
          <article class="flex flex-col">
            <h3 class="display-tight text-5xl text-navy">{p.verb}</h3>
            <p class="mt-4 flex-1 leading-relaxed text-muted">{p.body}</p>
            <a href={p.href} class="group mt-6 block border-t-2 border-orange pt-4">
              <span class="text-xs font-semibold tracking-wide text-muted uppercase">
                {p.liveMeta}
              </span>
              <span class="mt-1 block font-semibold text-navy group-hover:underline">{p.live}</span>
              <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-orange-deep">
                {p.cta}
                <Icon
                  name="lucide:arrow-right"
                  class="size-4 transition-transform group-hover:translate-x-1"
                  aria-hidden="true"
                />
              </span>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  {/* Advocacy, newspaper-style: dated, with its source in plain sight. */}
  <section class="bg-sky py-20 md:py-28">
    <div class="mx-auto max-w-6xl px-5">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <SectionHeader eyebrow="Representación" title="Lo que gestionamos" />
        </div>
        <a href="/nosotros#gestiones" class="link-underline font-semibold text-navy"
          >Ver las {advocacy.length} gestiones</a
        >
      </div>
      <ol class="mt-10 divide-y divide-sky-2 border-y border-sky-2">
        {
          recentAdvocacy.map((g) => {
            const SourceLink = g.source.href.startsWith('/') ? 'a' : ExternalLink;
            return (
              <li class="grid gap-2 py-6 md:grid-cols-[9rem_1fr_16rem] md:items-baseline md:gap-8">
                <p class="text-sm font-semibold text-muted">
                  <time datetime={g.date}>{dayMonthYear.format(new Date(g.date))}</time>
                </p>
                <h3 class="text-xl leading-snug text-navy">{g.title}</h3>
                <SourceLink href={g.source.href} class="link-underline text-sm text-muted">
                  Fuente: {g.source.label}
                </SourceLink>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  {/* The magazine as the flagship it is. */}
  <section class="bg-navy py-20 text-white md:py-28">
    <div class="mx-auto max-w-6xl px-5">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <div class="max-w-xl">
          <SectionHeader
            eyebrow={`Revista · ${latest.number} ediciones`}
            title={`Imagen ${site.acronym}`}
            tone="navy"
          />
          <p class="mt-5 text-lg leading-relaxed text-sky-2">
            Nuestra revista digital, gratuita: actualidad del comercio y la industria de Azul,
            novedades institucionales y comercios de la ciudad.
          </p>
        </div>
        <div class="flex flex-wrap gap-4">
          <a href={`/revista/${latest.number}`} class="btn-primary inline-flex items-center gap-2">
            <Icon name="lucide:book-open" class="size-5" aria-hidden="true" />
            Leer la N.º {latest.number}
          </a>
          <a href="/revista" class="btn-secondary">Todas las ediciones</a>
        </div>
      </div>

      <ul
        class="-mx-5 mt-12 flex snap-x snap-mandatory gap-6 overflow-x-auto px-5 pb-4 [&_.text-muted]:text-sky-2 [&_.text-navy]:text-white [&>li]:w-40 [&>li]:shrink-0 [&>li]:snap-start lg:[&>li]:w-[calc((100%-7.5rem)/6)]"
      >
        {recentIssues.map((issue) => <IssueCard issue={issue} cover={coverFor(issue.cover)} />)}
      </ul>
    </div>
  </section>

  {/* Membership: the price next to what it buys. */}
  <section class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <div class="grid gap-12 md:grid-cols-[1fr_1.2fr] md:gap-16">
      <div>
        <SectionHeader eyebrow="Asociate" title="Ser socio rinde" />
        <p class="mt-8 flex items-baseline gap-3">
          <span class="stat-figure text-navy">{membership.fee}</span>
          <span class="text-lg text-muted">{membership.feePeriod}</span>
        </p>
        <p class="mt-4 max-w-sm leading-relaxed text-muted">
          Para {membership.audience.join(', ').toLowerCase()} de {site.city}. Integramos{' '}
          {affiliationsProse}.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <ExternalLink href={whatsappJoinUrl} class="btn-primary">Quiero asociarme</ExternalLink>
          <a href="/beneficios" class="btn-outline">Ver los {benefits.length} beneficios</a>
        </div>
      </div>

      <ul class="grid gap-4 self-center sm:grid-cols-2">
        {
          benefitPreview.map((b) => (
            <li class="card flex items-start gap-4 p-5">
              <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-sky text-navy">
                <Icon name={benefitTags[b.tag]} class="size-5" aria-hidden="true" />
              </span>
              <span>
                <span class="block font-semibold text-navy">{b.name}</span>
                <span class="mt-1 block text-sm text-muted">{b.tag}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-sky py-20 md:py-28">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 md:grid-cols-[0.9fr_1.1fr] md:gap-16">
      <div>
        <p class="eyebrow text-orange-deep">Historia</p>
        <p
          class="display-tight mt-4 text-[clamp(5rem,16vw,11rem)] leading-none text-navy"
          aria-hidden="true"
        >
          {site.founded}
        </p>
        <h2 class="mt-6 max-w-md text-2xl leading-snug text-navy">
          Más de un siglo representando a las empresas de {site.city}
        </h2>
        <p class="mt-4 max-w-md text-lg leading-relaxed text-muted">
          Nacimos el {site.foundedLong} como {site.foundingName}.
        </p>
        <a href="/nosotros" class="link-underline mt-6 inline-block font-semibold text-navy"
          >Conocé nuestra historia y cómo nos organizamos</a
        >
      </div>

      <ol class="ml-1.5 space-y-8 self-center border-l-2 border-sky-2 pl-8">
        {
          historyMilestones.map((m) => (
            <li class="relative">
              <span
                class="absolute top-1.5 -left-[2.4rem] size-3.5 rounded-full border-2 border-sky bg-orange"
                aria-hidden="true"
              />
              <p class="display-tight text-2xl text-orange-deep">{m.year}</p>
              <p class="mt-1 leading-relaxed text-ink">{m.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* Closing: the two things anyone can do today. */}
  <section class="bg-navy-deep text-white">
    <SlashBand height="h-3" />
    <div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 md:grid-cols-2 md:gap-16 md:py-24">
      <div>
        <h2 class="display-tight text-h1">Hablemos</h2>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-sky-2">
          La vía más rápida es WhatsApp. Atendemos {site.officeHours}.
        </p>
        <ExternalLink
          href={site.whatsappUrl}
          class="btn-primary mt-8 inline-flex items-center gap-2"
        >
          <Icon name="simple-icons:whatsapp" class="size-4" aria-hidden="true" />
          {site.whatsappDisplay}
        </ExternalLink>
      </div>
      <div class="md:border-l md:border-white/15 md:pl-16">
        <h2 class="display-tight text-h1">Guía de Azul</h2>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-sky-2">
          Sumá tu comercio, oficio o servicio a la guía del partido de {site.city}. Es gratis y
          lleva un minuto.
        </p>
        <ExternalLink
          href={site.registryForm}
          class="btn-secondary mt-8 inline-flex items-center gap-2"
        >
          Registrar mi negocio
          <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
        </ExternalLink>
      </div>
    </div>
  </section>
</Base>
