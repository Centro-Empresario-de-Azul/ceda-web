---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ExternalLink from '../components/ExternalLink.astro';
import BusinessDirectory from '../components/BusinessDirectory.astro';
import EventFeature from '../components/EventFeature.astro';
import { site, pageTitle } from '../site';
import asambleaImg from '../assets/img/asamblea.jpg';
import heroImg from '../assets/img/reunion-sede.jpg';
import { upcoming } from '../data/events';
---

<Base
  title={pageTitle('Programas e iniciativas')}
  description="Centro Comercial a Cielo Abierto, el padrón de comercios de Azul y Azul Mueve: los programas activos de CEDA."
>
  <PageHero
    eyebrow="Programas e iniciativas"
    title="Lo que CEDA está haciendo ahora"
    lead="Revitalización del centro y visibilidad para las empresas de Azul."
    image={heroImg}
  />

  {
    upcoming && (
      <section class="bg-navy py-20 md:py-24">
        <EventFeature event={upcoming} detailed />
      </section>
    )
  }

  <section>
    <div
      class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-20 md:grid-cols-2 md:gap-16 md:py-28"
    >
      <div>
        <SectionHeader eyebrow="Ciudad" title="Centro Comercial a Cielo Abierto" />
        <div class="mt-6 space-y-5 text-lg leading-relaxed text-muted">
          <p>
            El centro de Azul fue siempre el corazón comercial, social y cultural de la ciudad. Las
            crisis económicas y el cambio en los hábitos de consumo le fueron quitando movimiento.
          </p>
          <p>
            Otras ciudades ya revitalizaron sus centros con iniciativas comerciales a cielo abierto.
            El proyecto nació de comerciantes preocupados por el futuro del centro y CEDA lo
            presentó ante las autoridades municipales, alineado a la iniciativa de CAME.
          </p>
          <p>
            Lo público y lo privado trabajando juntos para fortalecer el comercio local, generar
            empleo, atraer visitantes y volver a encontrarnos en el centro.
          </p>
        </div>
      </div>

      <Image
        src={asambleaImg}
        alt="Socios de CEDA durante una reunión de trabajo en la sede"
        widths={[480, 800, 1200]}
        sizes="(max-width: 768px) 100vw, 45vw"
        loading="lazy"
        class="reveal aspect-[4/5] w-full rounded-2xl object-cover"
      />
    </div>
  </section>

  <BusinessDirectory tone="sky" detailed />

  <section class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <article class="reveal card p-8 md:p-12">
      <SectionHeader eyebrow="Comunidad" title="Azul Mueve" />
      <p class="mt-4 max-w-2xl leading-relaxed text-muted">
        Las historias de quienes producen, emprenden y dan trabajo en Azul, contadas por sus
        protagonistas. Las publicamos en nuestras redes.
      </p>
      <ExternalLink
        href={site.instagram}
        class="link-underline mt-6 inline-block font-semibold text-navy"
      >
        Verlas en Instagram
      </ExternalLink>
    </article>
  </section>
</Base>
