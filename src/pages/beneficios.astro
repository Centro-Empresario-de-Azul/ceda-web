---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactBand from '../components/ContactBand.astro';
import { site, pageTitle } from '../site';

import { benefits } from '../data/institutional';
import sociosImg from '../assets/img/equipo-mesa.jpg';
---

<Base
  title={pageTitle('Beneficios para socios')}
  description={`Descuentos en bancos, seguros y salud, y alquiler del salón de usos múltiples, para los socios del ${site.name}.`}
>
  <PageHero
    eyebrow="Beneficios"
    title="Ser socio rinde"
    lead={`Lo que obtenés por formar parte del ${site.name}.`}
  />

  <section class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <div class="grid gap-6 md:grid-cols-2">
      {
        benefits.map((b) => (
          <article class="reveal flex flex-col rounded-2xl border border-sky-2 bg-white p-8">
            <p class="eyebrow text-orange-deep">{b.tag}</p>
            <h2 class="mt-4 text-2xl leading-tight text-navy">{b.name}</h2>
            <p class="mt-4 leading-relaxed text-muted">{b.body}</p>
          </article>
        ))
      }
    </div>

    <p class="mt-10 text-sm leading-relaxed text-muted">
      Beneficios sujetos a confirmación y actualización por CEDA. Consultá por WhatsApp las
      condiciones antes de gestionarlos.
    </p>

    <Image
      src={sociosImg}
      alt="Socias y socios de CEDA reunidos en la sede"
      widths={[640, 1024, 1440]}
      sizes="(max-width: 1152px) 100vw, 1100px"
      loading="lazy"
      class="reveal mt-14 aspect-[16/9] w-full rounded-2xl object-cover"
    />
  </section>

  <ContactBand title="¿Todavía no sos socio?" note={site.whatsappDisplay}>
    Escribinos y te contamos cómo sumarte a {site.acronym} y empezar a usar los beneficios.
  </ContactBand>
</Base>
