---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactBand from '../components/ContactBand.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { site, pageTitle, whatsappJoinUrl } from '../site';

import { benefits, membership } from '../data/institutional';
import sociosImg from '../assets/img/equipo-mesa.jpg';
---

<Base
  title={pageTitle('Beneficios para socios')}
  description={`Pagos, bancos, seguros, logística y servicios profesionales con descuento, y el salón de la sede, para los socios del ${site.name}. Cómo asociarte.`}
>
  <PageHero
    eyebrow="Beneficios"
    title="Ser socio rinde"
    lead={`Lo que obtenés por formar parte del ${site.name}.`}
  />

  <section class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <div class="grid gap-6 md:grid-cols-2">
      {
        benefits.map((b) => (
          <article class="reveal flex flex-col rounded-2xl border border-sky-2 bg-white p-8">
            <p class="eyebrow text-orange-deep">{b.tag}</p>
            <h2 class="mt-4 text-2xl leading-tight text-navy">{b.name}</h2>
            <p class="mt-4 leading-relaxed text-muted">{b.body}</p>
          </article>
        ))
      }
    </div>

    <p class="mt-10 text-sm leading-relaxed text-muted">
      Beneficios sujetos a confirmación y actualización por CEDA. Consultá por WhatsApp las
      condiciones antes de gestionarlos.
    </p>

    <Image
      src={sociosImg}
      alt="Socias y socios de CEDA reunidos en la sede"
      widths={[640, 1024, 1440]}
      sizes="(max-width: 1152px) 100vw, 1100px"
      loading="lazy"
      class="reveal mt-14 aspect-[16/9] w-full rounded-2xl object-cover"
    />
  </section>

  <section id="asociate" class="scroll-mt-20 bg-sky py-20 md:py-28">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 md:grid-cols-2 md:gap-16">
      <div>
        <SectionHeader eyebrow="Asociate" title={`¿Por qué asociarte al ${site.acronym}?`} />
        <p class="mt-5 text-lg leading-relaxed text-muted">
          Para {membership.audience.join(', ').toLowerCase()} de {site.city}.
        </p>
        <ul class="mt-8 space-y-3">
          {
            membership.reasons.map((r) => (
              <li class="flex items-start gap-3 text-ink">
                <Icon
                  name="lucide:check"
                  class="mt-1 size-5 shrink-0 text-orange-deep"
                  aria-hidden="true"
                />
                {r}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="self-start rounded-2xl border border-sky-2 bg-white p-8">
        <p class="eyebrow text-muted">Cuota social</p>
        <p class="display-tight mt-3 text-4xl text-navy">{membership.fee}</p>
        <p class="mt-2 text-sm text-muted">
          Según la{' '}
          <a href={membership.feeSource.href} class="link-underline">{membership.feeSource.label}</a
          >.
        </p>
        <ol class="mt-8 space-y-3 text-ink">
          <li><strong class="font-semibold text-navy">1.</strong> Escribinos por WhatsApp.</li>
          <li>
            <strong class="font-semibold text-navy">2.</strong> Te contamos los requisitos y cómo abonar
            la cuota.
          </li>
          <li>
            <strong class="font-semibold text-navy">3.</strong> Empezás a usar los beneficios.
          </li>
        </ol>
        <ExternalLink href={whatsappJoinUrl} class="btn-primary mt-8">Quiero asociarme</ExternalLink
        >
      </div>
    </div>
  </section>

  <ContactBand title="¿Dudas sobre un beneficio?" note={site.whatsappDisplay}>
    Escribinos y te contamos las condiciones de cada convenio antes de que lo gestiones.
  </ContactBand>
</Base>
