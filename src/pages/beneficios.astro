---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactBand from '../components/ContactBand.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { site, pageTitle, whatsappJoinUrl } from '../site';

import { benefits, benefitTags, membership, usedBenefitTags } from '../data/institutional';
import heroImg from '../assets/img/equipo-mesa.jpg';
---

<Base
  title={pageTitle('Beneficios para socios')}
  description={`Pagos, bancos, seguros, logística y servicios profesionales con descuento, y el salón de la sede, para los socios del ${site.name}. Cómo asociarte.`}
>
  <PageHero
    eyebrow="Beneficios"
    title="Ser socio rinde"
    lead={`${benefits.length} beneficios por formar parte del ${site.name}, desde ${membership.fee} ${membership.feePeriod}.`}
    image={heroImg}
  >
    <ExternalLink href={whatsappJoinUrl} class="btn-primary">Quiero asociarme</ExternalLink>
    <a href="#asociate" class="btn-secondary">Cómo asociarte</a>
  </PageHero>

  <section class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <div
      data-benefit-filter
      hidden
      role="group"
      aria-label="Filtrar beneficios por categoría"
      class="flex flex-wrap gap-2"
    >
      {
        [['', 'Todos'] as const, ...usedBenefitTags.map((t) => [t, t] as const)].map(
          ([tag, label]) => (
            <button
              type="button"
              data-tag={tag}
              aria-pressed={tag === '' ? 'true' : 'false'}
              class="rounded-full border border-muted/40 px-4 py-2 text-sm font-semibold text-navy transition-colors hover:border-navy aria-pressed:border-navy aria-pressed:bg-navy aria-pressed:text-white"
            >
              {label}
            </button>
          ),
        )
      }
    </div>
    <p data-benefit-status class="sr-only" aria-live="polite"></p>

    <ul data-benefit-list class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        benefits.map((b) => (
          <li data-tag={b.tag} class="card flex flex-col p-7">
            <div class="flex items-center gap-3">
              <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-sky text-navy">
                <Icon name={benefitTags[b.tag]} class="size-5" aria-hidden="true" />
              </span>
              <p class="eyebrow text-orange-deep">{b.tag}</p>
            </div>
            <h2 class="mt-5 text-xl leading-tight text-navy">{b.name}</h2>
            <p class="mt-3 leading-relaxed text-muted">{b.body}</p>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 text-sm leading-relaxed text-muted">
      Beneficios sujetos a confirmación y actualización por {site.acronym}. Consultá por WhatsApp
      las condiciones antes de gestionarlos.
    </p>
  </section>

  <section id="asociate" class="scroll-mt-20 bg-sky py-20 md:py-28">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 md:grid-cols-[1.1fr_1fr] md:gap-16">
      <div>
        <SectionHeader eyebrow="Asociate" title={`¿Por qué asociarte al ${site.acronym}?`} />
        <p class="mt-5 text-lg leading-relaxed text-muted">
          Para {membership.audience.join(', ').toLowerCase()} de {site.city}.
        </p>
        <ul class="mt-8 space-y-4">
          {
            membership.reasons.map((r) => (
              <li class="flex items-start gap-3 text-ink">
                <Icon
                  name="lucide:check"
                  class="mt-1 size-5 shrink-0 text-orange-deep"
                  aria-hidden="true"
                />
                {r}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="tile self-start bg-navy p-8 text-white md:p-10">
        <p class="eyebrow text-orange-bright">Cuota social</p>
        <p class="stat-figure mt-4">{membership.fee}</p>
        <p class="mt-2 text-lg text-sky-2">{membership.feePeriod}</p>
        <ol class="mt-8 space-y-4 text-sky-2">
          {
            [
              'Escribinos por WhatsApp.',
              'Te contamos los requisitos y cómo abonar la cuota.',
              'Empezás a usar los beneficios.',
            ].map((step, i) => (
              <li class="flex items-start gap-3">
                {/* The <ol> already numbers the steps for assistive tech. */}
                <span
                  class="grid size-7 shrink-0 place-items-center rounded-full bg-white/10 text-sm font-semibold text-white"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                <span>{step}</span>
              </li>
            ))
          }
        </ol>
        <ExternalLink href={whatsappJoinUrl} class="btn-primary mt-9">Quiero asociarme</ExternalLink
        >
        <p class="mt-5 text-xs text-sky-2">
          Valor publicado en la{' '}
          <a href={membership.feeSource.href} class="link-underline text-white"
            >{membership.feeSource.label}</a
          >.
        </p>
      </div>
    </div>
  </section>

  <ContactBand title="¿Dudas sobre un beneficio?" note={site.whatsappDisplay}>
    Escribinos y te contamos las condiciones de cada convenio antes de que lo gestiones.
  </ContactBand>

  <script src="/js/benefit-filter.js" is:inline defer></script>
</Base>
