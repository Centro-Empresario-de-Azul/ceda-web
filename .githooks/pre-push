#!/bin/sh
# Slower gate: build, then check the built HTML for the failure modes that a linter
# structurally cannot see — they all produce valid code that renders wrongly.
set -e

echo "→ build"
# Quiet on success, but a failed build prints its log — astro check's diagnostics live there.
log=$(mktemp)
npm run build >"$log" 2>&1 || { cat "$log"; rm -f "$log"; echo "✗ Build failed."; exit 1; }
rm -f "$log"

echo "→ source checks"
# ExternalLink is the one place rel="noopener noreferrer" is written; a hand-rolled
# target=_blank elsewhere is how one eventually ships without it.
if grep -rln 'rel="noopener' src --include='*.astro' | grep -v 'src/components/ExternalLink.astro'; then
  echo "✗ Use <ExternalLink> instead of a hand-written target=_blank link (files above)."
  exit 1
fi

echo "→ content checks"
node --input-type=module -e '
import { readFileSync, readdirSync } from "node:fs";

// Recursive: /revista/<number> pages live in a subdirectory, and a top-level-only scan
// silently skipped every one of them.
const pages = readdirSync("dist", { recursive: true }).filter((f) => String(f).endsWith(".html"));
let failed = 0;
const fail = (msg) => { console.error("  ✗ " + msg); failed = 1; };

for (const page of pages) {
  const html = readFileSync("dist/" + page, "utf8");

  // The magazine text on /revista/<n> is excluded from every check: it is the issue
  // verbatim, old phone numbers and all.
  const doc = html.replace(/<details[^>]*data-magazine-text[\s\S]*?<\/details>/g, "");
  const body = doc.slice(doc.indexOf("<body"));

  // Astro strips the newline between text and an adjacent element, fusing words
  // ("solo.Desde"). Valid HTML, wrong copy — only visible in the output.
  for (const m of body.matchAll(/<(p|li|dd|dt|h[1-4]|a)\b[^>]*>(.*?)<\/\1>/gs)) {
    if (/<(p|div|section|ul|ol)\b/.test(m[2])) continue;
    const text = m[2].replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
    const fused = text.match(/[a-záéíóúñ]\.[A-ZÁÉÍÓÚÑ][a-záéíóúñ]{2,}/);
    if (fused) fail(page + ": fused words — " + fused[0] + "  (add {\" \"} between the text and the tag)");
  }

  // The same collapse at an inline tag boundary: "municipio y<strong>318" renders as
  // "y318". Prettier can move a word onto the line of the tag and cause it.
  const inline = "strong|a|span|em|b|time";
  const text = body.slice(0, body.lastIndexOf("<script"));
  for (const re of [
    new RegExp("[\\p{L}\\p{N},;:]<(" + inline + ")\\b[^>]*>(?:<[^>]+>)*[\\p{L}\\p{N}¿¡$]", "gu"),
    new RegExp("</(" + inline + ")>[\\p{L}\\p{N}¿¡$]", "gu"),
  ]) {
    for (const m of text.matchAll(re)) {
      const around = text.slice(Math.max(0, m.index - 25), m.index + 45).replace(/<[^>]+>/g, "|");
      fail(page + ": word fused at a tag — …" + around + "…  (add {\" \"})");
    }
  }

  // Retired contact details and the shortener must never reappear, including in the head
  // (meta description, JSON-LD). CEDA has one line, WhatsApp 2281 58-3969 (src/site.ts).
  for (const [re, label] of [
    [/42-?4028/, "retired landline 02281 42-4028"],
    [/47-?7297/, "retired number 2281 47-7297"],
  ]) {
    if (re.test(doc)) fail(page + ": " + label);
  }
  if (doc.includes("bit.ly")) fail(page + ": bit.ly shortener — link the destination directly");
  if (/entidad gremial/i.test(doc)) fail(page + ": CEDA is a cámara empresarial, not an entidad gremial");
}

// public/ is copied verbatim, so anything that lands in it ships — including junk the
// editor drops there. .DS_Store is gitignored, so git never warns about it.
const junk = readdirSync("dist", { recursive: true })
  .filter((f) => /(^|\/)(\.DS_Store|Thumbs\.db)$/.test(String(f)));
for (const f of junk) fail("dist/" + f + " would be deployed — delete it from public/");

if (failed) { console.error("\n✗ Content checks failed."); process.exit(1); }
console.log("  ✓ " + pages.length + " pages clean");
'

echo "✓ pre-push passed"
